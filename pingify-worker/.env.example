# Postgres — same database as the backend
# (must be non-empty: env.ts throws on missing/blank vars)
DB_HOST=localhost
DB_PORT=5432
DB_USER=davinder
DB_PASSWORD=7815
DB_NAME=pingify

PORT=3002
NODE_ENV=development

# Redis — REDIS_URL and REDIS_STREAM_NAME must match the backend exactly
REDIS_URL=redis://localhost:6379
REDIS_STREAM_NAME=pingify:pings
REDIS_GROUP_NAME=pingify-workers

# 1-3 read the stream, 4 reclaims stale pending messages
REDIS_CONSUMER_1=worker-1
REDIS_CONSUMER_2=worker-2
REDIS_CONSUMER_3=worker-3
REDIS_CONSUMER_4=worker-recovery
